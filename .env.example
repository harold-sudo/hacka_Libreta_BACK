# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# HSK Chain Configuration (EVM Testnet / Mainnet)
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
HSK_OPERATOR_PRIVATE_KEY=0x...
LIBRETA_REGISTRY_ADDRESS=0x...

# Pollar Stellar TESTNET: emisor G... del USDC habilitado en tu app Pollar.
# Debe coincidir exactamente, incluyendo el issuer, no solo el símbolo USDC.
POLLAR_TESTNET_USDC_ISSUER=
# Webhook legado deshabilitado para conciliación. Sin secreto por defecto.
POLLAR_WEBHOOK_SECRET=

# Unlock Protocol Configuration (Base / Polygon Bounty)
UNLOCK_LOCK_ADDRESS=0x...
UNLOCK_NETWORK_RPC=https://mainnet.base.org
# TTL (ms) de la caché en memoria de getHasValidKey; 0 desactiva la caché.
UNLOCK_CACHE_TTL_MS=30000

# Envelope Encryption (Habeas Data off-chain PII)
AES_SECRET_KEY=e4d9b238f1a74289c091bc6547890def1234567890abcdef1234567890abcdef

# --- Audit trail (zero-PII; requiere migrations/20260912_audit_logs.sql) ---
# Escucha on-chain de eventos LibretaRegistry -> audit_logs
AUDIT_LISTENER_ENABLED=false
# Bloques a re-sincronizar si el cursor no existe aún.
AUDIT_BACKFILL_BLOCKS=1000
# Clave para el API de consulta /api/audit (x-audit-key header).
AUDIT_API_KEY=change-me-local-only
